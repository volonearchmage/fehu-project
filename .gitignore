# ============================================================
# FEHU secrets and local environment
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# ML caches and experiment services
# ============================================================
.cache/
**/.cache/
wandb/
**/wandb/
runs/
**/runs/

# ============================================================
# Large model checkpoints and weights
# Keep reports, metrics, JSON and JSONL results in output/
# ============================================================
**/checkpoint-*/
**/checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
pytorch_model.bin
optimizer.pt
scheduler.pt
rng_state*.pth

# Temporary generated files
*.tmp
*.swp

# ============================================================
# Python caches (belt-and-suspenders; also in ntcir19_fehu-master/.gitignore)
# ============================================================
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
**/.pytest_cache/

# ============================================================
# API response caches (raw model outputs; regenerable, may be large)
# ============================================================
**/logs/cache_*.json
**/cache_dev_*.json
**/cache_test_*.json

# ============================================================
# External papers / non-code binaries (not project source)
# ============================================================
*.pdf

# ============================================================
# Unnecessarily large regenerable generated/augmented data outputs
# (kept out of the handoff; reproducible from the augmentation scripts)
# ============================================================
**/*_official_plus_900.json
